# Copy to .env to override any of these. The values here are also the
# defaults baked into pipeline/config.py, so a .env file is optional and
# Streamlit Community Cloud (which has none) runs fine without one.

# Random seed for the synthetic data generator. Any integer.
VELLA_SEED=20240117

# Reporting cut-off date (ISO). Sits about two weeks after the last order
# month, so the most recent months still have returns in flight.
VELLA_AS_OF_DATE=2026-09-15

# VAT rate used to convert own-store (VAT-inclusive) prices to net revenue.
VAT_RATE=0.20
